# Local hardhat node
RPC_URL=http://127.0.0.1:8545

# Address that holds the VERIFIER_ROLE / disburser role and signs on-chain
# admin actions triggered by the backend (e.g. auto-approving after KYC).
# NEVER commit a real private key. Use a dedicated hot wallet with limited funds.
VERIFIER_PRIVATE_KEY=

# Fill in after running `npm run deploy:local` in /contracts
ELIGIBILITY_REGISTRY_ADDRESS=
DISBURSEMENT_CONTRACT_ADDRESS=
PAYOUT_TOKEN_ADDRESS=

# JWT session signing secret
JWT_SECRET=change-me-in-production

PORT=4000
