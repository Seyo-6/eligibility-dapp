# Sepolia RPC endpoint (Alchemy, Infura, QuickNode, etc.)
RPC_URL=https://sepolia.example-rpc

# Dedicated verifier wallet private key. NEVER commit a real key.
VERIFIER_PRIVATE_KEY=

# Comma-separated wallets allowed to use the verifier UI.
VERIFIER_ADDRESSES=

# Comma-separated wallets allowed to use the admin panel (manage verifiers, pause/unpause).
ADMIN_ADDRESSES=

ELIGIBILITY_REGISTRY_ADDRESS=

# Optional legacy disbursement configuration
DISBURSEMENT_CONTRACT_ADDRESS=
PAYOUT_TOKEN_ADDRESS=

# Random long secret for JWT sessions
JWT_SECRET=change-me-in-production

# Public frontend URL, used for CORS
FRONTEND_URL=http://localhost:5173

PORT=4000
